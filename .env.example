# 프론트엔드가 호출할 서버리스 API 경로입니다.
# 기본값은 /api/prices 이므로 보통 수정하지 않아도 됩니다.
VITE_GOLD_API_ENDPOINT=/api/prices
# 문의 버튼 오픈카톡 링크
VITE_OPEN_KAKAO_URL=https://open.kakao.com/o/your_open_chat_path

# ---------------------------------------------
# 서버 환경변수 예시
# ---------------------------------------------
# Gold API (실시간 금속 spot 시세)
# 무료 Price 엔드포인트는 키 없이 동작합니다. 필요 시 키를 넣어 확장 가능
# 문서: https://api.gold-api.com
GOLD_API_BASE_URL=https://api.gold-api.com
GOLD_API_KEY=your_gold_api_key_optional

# USD/KRW 환율 설정
# 1) 고정환율을 강제로 쓰려면 USD_KRW_FIXED_RATE를 설정
# 2) 환율 API 실패 시 USD_KRW_FALLBACK_RATE 사용
USD_KRW_FIXED_RATE=
USD_KRW_FALLBACK_RATE=1370

# (선택) 환율 API 주소
# 기본값: https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
# (선택) 일부 환율 API 공급자는 키가 필요합니다. 예: Open Exchange Rates
EXCHANGE_RATE_API_KEY=

# 운영 환경에서 실패 시 fallback mock을 허용하려면 true
ALLOW_MOCK_FALLBACK=false

# (선택) 목표 시세 자동 정렬 (입력값 기반)
# KST 슬롯 우선순위: *_00 / *_12 / *_18 -> 기본값
# 단위: KRW, 3.75g 기준값 입력
PRICE_ALIGN_PROPAGATE_GOLD=true
PRICE_ALIGN_TARGET_BUY_24K_3_75G=
PRICE_ALIGN_TARGET_SELL_24K_3_75G=
PRICE_ALIGN_TARGET_BUY_24K_3_75G_00=
PRICE_ALIGN_TARGET_SELL_24K_3_75G_00=
PRICE_ALIGN_TARGET_BUY_24K_3_75G_12=
PRICE_ALIGN_TARGET_SELL_24K_3_75G_12=
PRICE_ALIGN_TARGET_BUY_24K_3_75G_18=
PRICE_ALIGN_TARGET_SELL_24K_3_75G_18=
# 필요하면 자산별 직접 정렬값도 설정 가능
# 예) PRICE_ALIGN_TARGET_BUY_PLATINUM_3_75G=400000
# 예) PRICE_ALIGN_TARGET_SELL_PLATINUM_3_75G=360000
